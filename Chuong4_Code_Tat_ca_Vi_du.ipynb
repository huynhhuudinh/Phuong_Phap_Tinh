   "source": [
    "\n",
    "import math\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import sympy as sp\n",
    "\n",
    "pd.set_option(\"display.precision\", 12)\n",
    "\n",
    "x = sp.symbols(\"x\")\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Các hàm dùng chung\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def lagrange_value(x_nodes, y_nodes, x_eval):\n",
    "    x_nodes = np.asarray(x_nodes, dtype=float)\n",
    "    y_nodes = np.asarray(y_nodes, dtype=float)\n",
    "\n",
    "    total = 0.0\n",
    "    n = len(x_nodes)\n",
    "\n",
    "    for i in range(n):\n",
    "        omega = 1.0\n",
    "        for j in range(n):\n",
    "            if i != j:\n",
    "                omega *= (x_eval - x_nodes[j]) / (x_nodes[i] - x_nodes[j])\n",
    "        total += y_nodes[i] * omega\n",
    "\n",
    "    return total\n",
    "\n",
    "def lagrange_polynomial(x_nodes, y_nodes, symbol=x):\n",
    "    poly = 0\n",
    "    n = len(x_nodes)\n",
    "\n",
    "    for i in range(n):\n",
    "        omega = 1\n",
    "        for j in range(n):\n",
    "            if i != j:\n",
    "                omega *= (symbol - x_nodes[j]) / (x_nodes[i] - x_nodes[j])\n",
    "        poly += y_nodes[i] * omega\n",
    "\n",
    "    return sp.expand(sp.simplify(poly))\n",
    "\n",
    "def lagrange_error_bound(x_nodes, x_eval, M):\n",
    "    n = len(x_nodes) - 1\n",
    "    psi = 1.0\n",
    "    for xi in x_nodes:\n",
    "        psi *= (x_eval - xi)\n",
    "    return M / math.factorial(n + 1) * abs(psi)\n",
    "\n",
    "def divided_difference_table(x_nodes, y_nodes):\n",
    "    x_nodes = np.asarray(x_nodes, dtype=float)\n",
    "    y_nodes = np.asarray(y_nodes, dtype=float)\n",
    "\n",
    "    n = len(x_nodes)\n",
    "    D = np.full((n, n), np.nan, dtype=float)\n",
    "    D[:, 0] = y_nodes\n",
    "\n",
    "    for k in range(1, n):\n",
    "        for i in range(n - k):\n",
    "            D[i, k] = (\n",
    "                D[i + 1, k - 1] - D[i, k - 1]\n",
    "            ) / (x_nodes[i + k] - x_nodes[i])\n",
    "\n",
    "    return D\n",
    "\n",
    "def newton_value(x_nodes, y_nodes, x_eval):\n",
    "    D = divided_difference_table(x_nodes, y_nodes)\n",
    "    n = len(x_nodes)\n",
    "\n",
    "    value = D[0, 0]\n",
    "    product = 1.0\n",
    "\n",
    "    for k in range(1, n):\n",
    "        product *= (x_eval - x_nodes[k - 1])\n",
    "        value += D[0, k] * product\n",
    "\n",
    "    return value\n",
    "\n",
    "def newton_polynomial(x_nodes, y_nodes, symbol=x):\n",
    "    D = divided_difference_table(x_nodes, y_nodes)\n",
    "    n = len(x_nodes)\n",
    "\n",
    "    poly = sp.Float(D[0, 0])\n",
    "    product = 1\n",
    "\n",
    "    for k in range(1, n):\n",
    "        product *= (symbol - x_nodes[k - 1])\n",
    "        poly += sp.Float(D[0, k]) * product\n",
    "\n",
    "    return sp.expand(poly), D\n",
    "\n",
    "def natural_cubic_spline(x_nodes, y_nodes):\n",
    "    x_nodes = np.asarray(x_nodes, dtype=float)\n",
    "    y_nodes = np.asarray(y_nodes, dtype=float)\n",
    "\n",
    "    n = len(x_nodes) - 1\n",
    "    h = np.diff(x_nodes)\n",
    "\n",
    "    # m_0 = m_n = 0\n",
    "    m = np.zeros(n + 1)\n",
    "\n",
    "    if n > 1:\n",
    "        T = np.zeros((n - 1, n - 1), dtype=float)\n",
    "        d = np.zeros(n - 1, dtype=float)\n",
    "\n",
    "        for r in range(1, n):\n",
    "            row = r - 1\n",
    "            T[row, row] = (h[r - 1] + h[r]) / 3\n",
    "\n",
    "            if r - 1 >= 1:\n",
    "                T[row, row - 1] = h[r - 1] / 6\n",
    "\n",
    "            if r + 1 <= n - 1:\n",
    "                T[row, row + 1] = h[r] / 6\n",
    "\n",
    "            d[row] = (\n",
    "                (y_nodes[r + 1] - y_nodes[r]) / h[r]\n",
    "                -\n",
    "                (y_nodes[r] - y_nodes[r - 1]) / h[r - 1]\n",
    "            )\n",
    "\n",
    "        m[1:n] = np.linalg.solve(T, d)\n",
    "\n",
    "    pieces = []\n",
    "\n",
    "    for i in range(n):\n",
    "        hi = h[i]\n",
    "        Ai = y_nodes[i] - m[i] * hi**2 / 6\n",
    "        Bi = y_nodes[i + 1] - m[i + 1] * hi**2 / 6\n",
    "\n",
    "        Si = (\n",
    "            m[i + 1] * (x - x_nodes[i])**3 / (6 * hi)\n",
    "            +\n",
    "            m[i] * (x_nodes[i + 1] - x)**3 / (6 * hi)\n",
    "            +\n",
    "            Ai * (x_nodes[i + 1] - x) / hi\n",
    "            +\n",
    "            Bi * (x - x_nodes[i]) / hi\n",
    "        )\n",
    "\n",
    "        pieces.append(sp.expand(Si))\n",
    "\n",
    "    return {\n",
    "        \"h\": h,\n",
    "        \"m\": m,\n",
    "        \"pieces\": pieces\n",
    "    }\n",
    "\n",
    "def spline_value(x_nodes, spline_data, x_eval):\n",
    "    x_nodes = np.asarray(x_nodes, dtype=float)\n",
    "    pieces = spline_data[\"pieces\"]\n",
    "\n",
    "    if x_eval < x_nodes[0] or x_eval > x_nodes[-1]:\n",
    "        raise ValueError(\"Điểm cần nội suy nằm ngoài miền các mốc.\")\n",
    "\n",
    "    if x_eval == x_nodes[-1]:\n",
    "        idx = len(x_nodes) - 2\n",
    "    else:\n",
    "        idx = np.searchsorted(x_nodes, x_eval, side=\"right\") - 1\n",
    "\n",
    "    return float(pieces[idx].subs(x, x_eval)), idx\n"
   ]
  },
