    "Ta cần tìm spline bậc ba tự nhiên\n",
    "\n",
    "\$$\n",
    "S(x)=S_i(x)\n",
    "\$$\n",
    "\n",
    "trên ba đoạn\n",
    "\n",
    "\$$\n",
    "[0,1],\\quad[1,3],\\quad[3,4].\n",
    "\$$\n",
    "\n",
    "Điều kiện biên tự nhiên:\n",
    "\n",
    "\$$\n",
    "m_0=m_3=0,\n",
    "\\qquad\n",
    "m_i=S''(x_i).\n",
    "\$$\n"
   ]
