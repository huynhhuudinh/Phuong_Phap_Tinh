   "source": [
    "\n",
    "import math\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "pd.set_option(\"display.precision\", 12)\n",
    "np.set_printoptions(precision=12, suppress=True)\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Các hàm dùng chung\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def least_squares_line(x, y):\n",
    "    x = np.asarray(x, dtype=float)\n",
    "    y = np.asarray(y, dtype=float)\n",
    "\n",
    "    if x.shape != y.shape:\n",
    "        raise ValueError(\"x và y phải có cùng kích thước.\")\n",
    "\n",
    "    n = len(x)\n",
    "\n",
    "    S1 = np.sum(x)\n",
    "    S2 = np.sum(x**2)\n",
    "    S3 = np.sum(y)\n",
    "    S4 = np.sum(x*y)\n",
    "\n",
    "    D = n*S2 - S1**2\n",
    "\n",
    "    if abs(D) < 1e-15:\n",
    "        raise ValueError(\"Không xác định được đường thẳng xấp xỉ duy nhất.\")\n",
    "\n",
    "    a = (n*S4 - S1*S3) / D\n",
    "    b = (S2*S3 - S1*S4) / D\n",
    "\n",
    "    return {\n",
    "        \"a\": a,\n",
    "        \"b\": b,\n",
    "        \"S1\": S1,\n",
    "        \"S2\": S2,\n",
    "        \"S3\": S3,\n",
    "        \"S4\": S4,\n",
    "        \"D\": D\n",
    "    }\n",
    "\n",
    "def r_squared(y, y_hat):\n",
    "    y = np.asarray(y, dtype=float)\n",
    "    y_hat = np.asarray(y_hat, dtype=float)\n",
    "\n",
    "    y_bar = np.mean(y)\n",
    "    SSE = np.sum((y - y_hat)**2)\n",
    "    SST = np.sum((y - y_bar)**2)\n",
    "\n",
    "    if abs(SST) < 1e-15:\n",
    "        return np.nan, SSE, SST\n",
    "\n",
    "    R2 = 1 - SSE/SST\n",
    "    return R2, SSE, SST\n",
    "\n",
    "def least_squares_two_basis(x, y, g, h):\n",
    "    x = np.asarray(x, dtype=float)\n",
    "    y = np.asarray(y, dtype=float)\n",
    "\n",
    "    gx = np.asarray([g(v) for v in x], dtype=float)\n",
    "    hx = np.asarray([h(v) for v in x], dtype=float)\n",
    "\n",
    "    A11 = np.sum(gx**2)\n",
    "    A12 = np.sum(gx*hx)\n",
    "    A22 = np.sum(hx**2)\n",
    "    B1 = np.sum(gx*y)\n",
    "    B2 = np.sum(hx*y)\n",
    "\n",
    "    D = A11*A22 - A12**2\n",
    "\n",
    "    if abs(D) < 1e-15:\n",
    "        raise ValueError(\"Không xác định duy nhất hai tham số a và b.\")\n",
    "\n",
    "    a = (B1*A22 - A12*B2) / D\n",
    "    b = (A11*B2 - A12*B1) / D\n",
    "\n",
    "    return {\n",
    "        \"a\": a,\n",
    "        \"b\": b,\n",
    "        \"A11\": A11,\n",
    "        \"A12\": A12,\n",
    "        \"A22\": A22,\n",
    "        \"B1\": B1,\n",
    "        \"B2\": B2,\n",
    "        \"D\": D,\n",
    "        \"gx\": gx,\n",
    "        \"hx\": hx\n",
    "    }\n",
    "\n",
    "def least_squares_polynomial(x, y, m):\n",
    "    x = np.asarray(x, dtype=float)\n",
    "    y = np.asarray(y, dtype=float)\n",
    "\n",
    "    # S_k = sum x_i^k, k=0,...,2m\n",
    "    S = np.array([np.sum(x**k) for k in range(2*m + 1)], dtype=float)\n",
    "\n",
    "    # T_k = sum x_i^k y_i, k=0,...,m\n",
    "    T = np.array([np.sum((x**k)*y) for k in range(m + 1)], dtype=float)\n",
    "\n",
    "    A = np.empty((m + 1, m + 1), dtype=float)\n",
    "    for j in range(m + 1):\n",
    "        for k in range(m + 1):\n",
    "            A[j, k] = S[j + k]\n",
    "\n",
    "    coeff = np.linalg.solve(A, T)  # [a_0, a_1, ..., a_m]\n",
    "\n",
    "    return {\n",
    "        \"coeff\": coeff,\n",
    "        \"S\": S,\n",
    "        \"T\": T,\n",
    "        \"A\": A\n",
    "    }\n",
    "\n",
    "def least_squares_exponential(x, y):\n",
    "    x = np.asarray(x, dtype=float)\n",
    "    y = np.asarray(y, dtype=float)\n",
    "\n",
    "    if np.any(y <= 0):\n",
    "        raise ValueError(\"Mô hình hàm mũ yêu cầu y_i > 0 để lấy logarit.\")\n",
    "\n",
    "    Y = np.log(y)\n",
    "    line = least_squares_line(x, Y)\n",
    "\n",
    "    A = line[\"a\"]  # = b\n",
    "    B = line[\"b\"]  # = ln(a)\n",
    "\n",
    "    return {\n",
    "        \"a\": math.exp(B),\n",
    "        \"b\": A,\n",
    "        \"A\": A,\n",
    "        \"B\": B,\n",
    "        \"Y\": Y,\n",
    "        \"line\": line\n",
    "    }\n",
    "\n",
    "def least_squares_power(x, y):\n",
    "    x = np.asarray(x, dtype=float)\n",
    "    y = np.asarray(y, dtype=float)\n",
    "\n",
    "    if np.any(x <= 0) or np.any(y <= 0):\n",
    "        raise ValueError(\"Mô hình lũy thừa yêu cầu x_i > 0 và y_i > 0.\")\n",
    "\n",
    "    X = np.log(x)\n",
    "    Y = np.log(y)\n",
    "\n",
    "    line = least_squares_line(X, Y)\n",
    "\n",
    "    A = line[\"a\"]  # = b\n",
    "    B = line[\"b\"]  # = ln(a)\n",
    "\n",
    "    return {\n",
    "        \"a\": math.exp(B),\n",
    "        \"b\": A,\n",
    "        \"A\": A,\n",
    "        \"B\": B,\n",
    "        \"X\": X,\n",
    "        \"Y\": Y,\n",
    "        \"line\": line\n",
    "    }\n",
    "\n",
    "def show_line_sums(result):\n",
    "    return pd.DataFrame({\n",
    "        \"Đại lượng\": [\"Σx_i\", \"Σx_i²\", \"Σy_i\", \"Σx_i y_i\", \"D\"],\n",
    "        \"Giá trị\": [\n",
    "            result[\"S1\"],\n",
    "            result[\"S2\"],\n",
    "            result[\"S3\"],\n",
    "            result[\"S4\"],\n",
    "            result[\"D\"]\n",
    "        ]\n",
    "    })\n"
   ]
  },
