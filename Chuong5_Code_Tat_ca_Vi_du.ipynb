    "\n",
    "Đặt\n",
    "\n",
    "\$$\n",
    "Y=\\ln y,\\qquad A=b,\\qquad B=\\ln a,\n",
    "\$$\n",
    "\n",
    "thì\n",
    "\n",
    "\$$\n",
    "Y=Ax+B.\n",
    "\$$\n"
