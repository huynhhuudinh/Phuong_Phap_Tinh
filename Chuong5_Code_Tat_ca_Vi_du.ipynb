    "\n",
    "## Ví dụ 8 — Xấp xỉ hàm lũy thừa\n",
    "\n",
    "Cho lại bảng\n",
    "\n",
    "\$$\n",
    "\\begin{array}{c|cccccc}\n",
    "x&1&2&4&8&11&13\\\\\n",
    "\\hline\n",
    "y&1&3&11&13&30&50\n",
    "\\end{array}\n",
    "\$$\n",
    "\n",
    "nhưng lần này tìm mô hình\n",
    "\n",
    "\$$\n",
    "y=ax^b\n",
    "\$$\n",
    "\n",
    "bằng phương pháp bình phương bé nhất sau phép biến đổi logarit.\n",
    "\n",
    "Đặt\n",
    "\n",
    "\$$\n",
    "X=\\ln x,\\qquad\n",
    "Y=\\ln y,\\qquad\n",
    "A=b,\\qquad\n",
    "B=\\ln a.\n",
    "\$$\n",
    "\n",
    "Khi đó,\n",
    "\n",
    "\$$\n",
    "Y=AX+B.\n",
    "\$$\n"
   ]
  },
