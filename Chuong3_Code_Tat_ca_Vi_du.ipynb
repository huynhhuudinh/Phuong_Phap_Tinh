    "\n",
    "import math\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "pd.set_option(\"display.precision\", 12)\n",
    "np.set_printoptions(precision=10, suppress=True)\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Các hàm dùng chung\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def back_substitution(U, y):\n",
    "    U = np.array(U, dtype=float)\n",
    "    y = np.array(y, dtype=float)\n",
    "    n = len(y)\n",
    "    x = np.zeros(n)\n",
    "    for i in range(n - 1, -1, -1):\n",
    "        if abs(U[i, i]) < 1e-15:\n",
    "            raise ValueError(\"Phần tử đường chéo bằng 0 trong thế ngược.\")\n",
    "        s = U[i, i+1:] @ x[i+1:]\n",
    "        x[i] = (y[i] - s) / U[i, i]\n",
    "    return x\n",
    "\n",
    "def forward_substitution(L, b):\n",
    "    L = np.array(L, dtype=float)\n",
    "    b = np.array(b, dtype=float)\n",
    "    n = len(b)\n",
    "    y = np.zeros(n)\n",
    "    for i in range(n):\n",
    "        if abs(L[i, i]) < 1e-15:\n",
    "            raise ValueError(\"Phần tử đường chéo bằng 0 trong thế tiến.\")\n",
    "        s = L[i, :i] @ y[:i]\n",
    "        y[i] = (b[i] - s) / L[i, i]\n",
    "    return y\n",
    "\n",
    "def gaussian_elimination(A, b, pivot=True):\n",
    "    A = np.array(A, dtype=float).copy()\n",
    "    b = np.array(b, dtype=float).copy()\n",
    "    n = len(b)\n",
    "    history = []\n",
    "\n",
    "    M = np.column_stack([A, b])\n",
    "    history.append(M.copy())\n",
    "\n",
    "    for k in range(n - 1):\n",
    "        if pivot:\n",
    "            p = k + np.argmax(np.abs(M[k:, k]))\n",
    "            if abs(M[p, k]) < 1e-15:\n",
    "                raise ValueError(\"Ma trận suy biến hoặc không có pivot khác 0.\")\n",
    "            if p != k:\n",
    "                M[[k, p]] = M[[p, k]]\n",
    "                history.append(M.copy())\n",
    "\n",
    "        if abs(M[k, k]) < 1e-15:\n",
    "            raise ValueError(\"Pivot bằng 0.\")\n",
    "\n",
    "        for i in range(k + 1, n):\n",
    "            m = M[i, k] / M[k, k]\n",
    "            M[i, k:] -= m * M[k, k:]\n",
    "        history.append(M.copy())\n",
    "\n",
    "    x = back_substitution(M[:, :-1], M[:, -1])\n",
    "    return x, M, history\n",
    "\n",
    "def crout_lu(A):\n",
    "    A = np.array(A, dtype=float)\n",
    "    n = A.shape[0]\n",
    "    L = np.zeros_like(A)\n",
    "    U = np.eye(n)\n",
    "\n",
    "    for j in range(n):\n",
    "        for i in range(j, n):\n",
    "            L[i, j] = A[i, j] - np.dot(L[i, :j], U[:j, j])\n",
    "\n",
    "        if abs(L[j, j]) < 1e-15:\n",
    "            raise ValueError(\"Không thể thực hiện phân tích Crout không pivot.\")\n",
    "\n",
    "        for i in range(j + 1, n):\n",
    "            U[j, i] = (\n",
    "                A[j, i] - np.dot(L[j, :j], U[:j, i])\n",
    "            ) / L[j, j]\n",
    "\n",
    "    return L, U\n",
    "\n",
    "def vector_norms(x):\n",
    "    x = np.array(x, dtype=float)\n",
    "    return {\n",
    "        \"||x||_1\": np.linalg.norm(x, 1),\n",
    "        \"||x||_2\": np.linalg.norm(x, 2),\n",
    "        \"||x||_inf\": np.linalg.norm(x, np.inf)\n",
    "    }\n",
    "\n",
    "def matrix_norms(A):\n",
    "    A = np.array(A, dtype=float)\n",
    "    return {\n",
    "        \"||A||_1\": np.linalg.norm(A, 1),\n",
    "        \"||A||_2\": np.linalg.norm(A, 2),\n",
    "        \"||A||_inf\": np.linalg.norm(A, np.inf)\n",
    "    }\n",
    "\n",
    "def strictly_row_diagonally_dominant(A):\n",
    "    A = np.array(A, dtype=float)\n",
    "    for i in range(A.shape[0]):\n",
    "        off = np.sum(np.abs(A[i])) - abs(A[i, i])\n",
    "        if abs(A[i, i]) <= off:\n",
    "            return False\n",
    "    return True\n",
    "\n",
    "def jacobi_H_g(A, b):\n",
    "    A = np.array(A, dtype=float)\n",
    "    b = np.array(b, dtype=float)\n",
    "    d = np.diag(A)\n",
    "    if np.any(np.abs(d) < 1e-15):\n",
    "        raise ValueError(\"Có phần tử đường chéo bằng 0.\")\n",
    "    H = -A / d[:, None]\n",
    "    np.fill_diagonal(H, 0.0)\n",
    "    g = b / d\n",
    "    return H, g\n",
    "\n",
    "def jacobi_steps(A, b, x0, n_steps):\n",
    "    H, g = jacobi_H_g(A, b)\n",
    "    q = np.linalg.norm(H, np.inf)\n",
    "    x_old = np.array(x0, dtype=float)\n",
    "    rows = []\n",
    "\n",
    "    for k in range(1, n_steps + 1):\n",
    "        x_new = H @ x_old + g\n",
    "        err = np.nan\n",
    "        if q < 1:\n",
    "            err = q / (1 - q) * np.linalg.norm(x_new - x_old, np.inf)\n",
    "        rows.append([k, *x_new, err])\n",
    "        x_old = x_new\n",
    "\n",
    "    cols = [\"k\"] + [f\"x{i+1}\" for i in range(len(x_old))] + [\"error_bound\"]\n",
    "    return pd.DataFrame(rows, columns=cols), H, g, q\n",
    "\n",
    "def jacobi_until_tol(A, b, x0, tol, max_iter=10000):\n",
    "    H, g = jacobi_H_g(A, b)\n",
    "    q = np.linalg.norm(H, np.inf)\n",
    "    if q >= 1:\n",
    "        raise ValueError(\"Điều kiện đủ q = ||H||_inf < 1 không được thỏa mãn.\")\n",
    "\n",
    "    x_old = np.array(x0, dtype=float)\n",
    "    rows = []\n",
    "\n",
    "    for k in range(1, max_iter + 1):\n",
    "        x_new = H @ x_old + g\n",
    "        err = q / (1 - q) * np.linalg.norm(x_new - x_old, np.inf)\n",
    "        rows.append([k, *x_new, err])\n",
    "        if err < tol:\n",
    "            break\n",
    "        x_old = x_new\n",
    "\n",
    "    cols = [\"k\"] + [f\"x{i+1}\" for i in range(len(x_old))] + [\"error_bound\"]\n",
    "    return pd.DataFrame(rows, columns=cols), H, g, q\n",
    "\n",
    "def gs_gamma_from_H(H):\n",
    "    H = np.array(H, dtype=float)\n",
    "    n = H.shape[0]\n",
    "    vals = []\n",
    "    for i in range(n):\n",
    "        alpha = np.sum(np.abs(H[i, :i]))\n",
    "        beta = np.sum(np.abs(H[i, i:]))\n",
    "        if 1 - alpha <= 0:\n",
    "            vals.append(np.inf)\n",
    "        else:\n",
    "            vals.append(beta / (1 - alpha))\n",
    "    return max(vals), vals\n",
    "\n",
    "def gauss_seidel_steps(A, b, x0, n_steps):\n",
    "    A = np.array(A, dtype=float)\n",
    "    b = np.array(b, dtype=float)\n",
    "    H, g = jacobi_H_g(A, b)\n",
    "    gamma, gamma_parts = gs_gamma_from_H(H)\n",
    "\n",
    "    x_old = np.array(x0, dtype=float)\n",
    "    rows = []\n",
    "\n",
    "    for k in range(1, n_steps + 1):\n",
    "        x_new = x_old.copy()\n",
    "        n = len(b)\n",
    "        for i in range(n):\n",
    "            s1 = A[i, :i] @ x_new[:i]\n",
    "            s2 = A[i, i+1:] @ x_old[i+1:]\n",
    "            x_new[i] = (b[i] - s1 - s2) / A[i, i]\n",
    "\n",
    "        err = np.nan\n",
    "        if gamma < 1:\n",
    "            err = gamma / (1 - gamma) * np.linalg.norm(x_new - x_old, np.inf)\n",
    "\n",
    "        rows.append([k, *x_new, err])\n",
    "        x_old = x_new\n",
    "\n",
    "    cols = [\"k\"] + [f\"x{i+1}\" for i in range(len(x_old))] + [\"error_bound\"]\n",
    "    return pd.DataFrame(rows, columns=cols), H, g, gamma, gamma_parts\n",
    "\n",
    "def gauss_seidel_until_tol(A, b, x0, tol, max_iter=10000):\n",
    "    A = np.array(A, dtype=float)\n",
    "    b = np.array(b, dtype=float)\n",
    "    H, g = jacobi_H_g(A, b)\n",
    "    gamma, gamma_parts = gs_gamma_from_H(H)\n",
    "\n",
    "    if gamma >= 1:\n",
    "        raise ValueError(\"Điều kiện đánh giá sai số gamma < 1 không được thỏa mãn.\")\n",
    "\n",
    "    x_old = np.array(x0, dtype=float)\n",
    "    rows = []\n",
    "\n",
    "    for k in range(1, max_iter + 1):\n",
    "        x_new = x_old.copy()\n",
    "        n = len(b)\n",
    "        for i in range(n):\n",
    "            s1 = A[i, :i] @ x_new[:i]\n",
    "            s2 = A[i, i+1:] @ x_old[i+1:]\n",
    "            x_new[i] = (b[i] - s1 - s2) / A[i, i]\n",
    "\n",
    "        err = gamma / (1 - gamma) * np.linalg.norm(x_new - x_old, np.inf)\n",
    "        rows.append([k, *x_new, err])\n",
    "\n",
    "        if err < tol:\n",
    "            break\n",
    "        x_old = x_new\n",
    "\n",
    "    cols = [\"k\"] + [f\"x{i+1}\" for i in range(len(x_old))] + [\"error_bound\"]\n",
    "    return pd.DataFrame(rows, columns=cols), H, g, gamma, gamma_parts\n",
    "\n",
    "def iteration_matrices(A, b):\n",
    "    A = np.array(A, dtype=float)\n",
    "    b = np.array(b, dtype=float)\n",
    "    D = np.diag(np.diag(A))\n",
    "    L = np.tril(A, -1)\n",
    "    U = np.triu(A, 1)\n",
    "\n",
    "    BJ = -np.linalg.solve(D, L + U)\n",
    "    gJ = np.linalg.solve(D, b)\n",
    "\n",
    "    BGS = -np.linalg.solve(D + L, U)\n",
    "    gGS = np.linalg.solve(D + L, b)\n",
    "\n",
    "    return D, L, U, BJ, gJ, BGS, gGS\n",
    "\n",
    "def spectral_radius(B):\n",
    "    eigvals = np.linalg.eigvals(B)\n",
    "    return np.max(np.abs(eigvals)), eigvals\n",
    "\n",
    "def gradient_descent_steps(A, b, x0, n_steps):\n",
    "    A = np.array(A, dtype=float)\n",
    "    b = np.array(b, dtype=float)\n",
    "    x = np.array(x0, dtype=float)\n",
    "    rows = []\n",
    "\n",
    "    r = b - A @ x\n",
    "    for k in range(n_steps):\n",
    "        e = np.linalg.norm(r, 2)\n",
    "        gamma = (r @ r) / (r @ A @ r)\n",
    "        rows.append([k, *x, gamma, e])\n",
    "        x = x + gamma * r\n",
    "        r = b - A @ x\n",
    "\n",
    "    rows.append([n_steps, *x, np.nan, np.linalg.norm(r, 2)])\n",
    "    cols = [\"k\"] + [f\"x{i+1}\" for i in range(len(x))] + [\"gamma_k\", \"residual_norm_2\"]\n",
    "    return pd.DataFrame(rows, columns=cols)\n",
    "\n",
    "def gradient_descent_until_tol(A, b, x0, tol, max_iter=10000):\n",
    "    A = np.array(A, dtype=float)\n",
    "    b = np.array(b, dtype=float)\n",
    "    x = np.array(x0, dtype=float)\n",
    "    rows = []\n",
    "\n",
    "    for k in range(max_iter + 1):\n",
    "        r = b - A @ x\n",
    "        e = np.linalg.norm(r, 2)\n",
    "\n",
    "        if e < tol:\n",
    "            rows.append([k, *x, np.nan, e])\n",
    "            break\n",
    "\n",
    "        gamma = (r @ r) / (r @ A @ r)\n",
    "        rows.append([k, *x, gamma, e])\n",
    "        x = x + gamma * r\n",
    "\n",
    "    cols = [\"k\"] + [f\"x{i+1}\" for i in range(len(x))] + [\"gamma_k\", \"residual_norm_2\"]\n",
    "    return pd.DataFrame(rows, columns=cols)\n"
   ]
