    "print(\"Các trị riêng của A:\", np.linalg.eigvalsh(A))\n",
    "\n",
    "tab_gd = gradient_descent_until_tol(\n",
    "    A, b, x0=np.zeros(3), tol=1e-3\n",
    ")\n",
    "tab_gd\n"
   ]
