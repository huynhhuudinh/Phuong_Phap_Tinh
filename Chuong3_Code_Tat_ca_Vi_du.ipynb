    "\n",
    "H = np.array([\n",
    "    [0.1, 0.2, 0.1],\n",
    "    [0.1, 0.1, 0.2],\n",
    "    [0.2, 0.1, 0.1]\n",
    "], dtype=float)\n",
    "g = np.array([50, 100, 80], dtype=float)\n",
    "\n",
    "q = np.linalg.norm(H, np.inf)\n",
    "x_old = g.copy()\n",
    "rows = []\n",
    "\n",
    "for k in range(1, 1000):\n",
    "    x_new = H @ x_old + g\n",
    "    err = q/(1-q) * np.linalg.norm(x_new - x_old, np.inf)\n",
    "    rows.append([k, *x_new, err])\n",
    "    if err < 1e-3:\n",
    "        break\n",
    "    x_old = x_new\n",
    "\n",
    "tab_leontief = pd.DataFrame(\n",
    "    rows,\n",
    "    columns=[\"k\", \"Nông nghiệp\", \"Công nghiệp\", \"Dịch vụ\", \"error_bound\"]\n",
    ")\n",
    "\n",
    "print(\"q =\", q)\n",
    "print(\"Số lần lặp =\", len(tab_leontief))\n",
    "tab_leontief\n"
   ]
