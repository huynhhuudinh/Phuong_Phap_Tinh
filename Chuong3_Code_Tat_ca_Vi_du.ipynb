    "\n",
    "## Ví dụ 10 — Gradient Descent\n",
    "\n",
    "Giải hệ\n",
    "\n",
    "\$$\n",
    "\\begin{aligned}\n",
    "12x_1+x_2+2x_3=15,\\\\\n",
    "x_1+12x_2+x_3=14,\\\\\n",
    "2x_1+x_2+12x_3=15.\n",
    "\\end{aligned}\n",
    "\$$\n",
    "\n",
    "Ma trận\n",
    "\n",
    "\$$\n",
    "\\mathbf A=\n",
    "\\begin{pmatrix}\n",
    "12&1&2\\\\\n",
    "1&12&1\\\\\n",
    "2&1&12\n",
    "\\end{pmatrix}\n",
    "\$$\n",
    "\n",
    "đối xứng xác định dương.\n",
    "\n",
    "Chọn\n",
    "\n",
    "\$$\n",
    "\\mathbf x_0=(0;0;0).\n",
    "\$$\n",
    "\n",
    "Dùng Gradient Descent với bước lặp tối ưu:\n",
    "\n",
    "\$$\n",
    "\\gamma_k\n",
    "=\n",
    "\\frac{\\mathbf r_k^T\\mathbf r_k}\n",
    "{\\mathbf r_k^T\\mathbf A\\mathbf r_k},\n",
    "\$$\n",
    "\n",
    "và dừng khi\n",
    "\n",
    "\$$\n",
    "\\|\\mathbf r_k\\|_2<10^{-3}.\n",
    "\$$\n"
   ]
  },
