    "\n",
    "x_limit = np.array([1.0, 2.0, 0.0])\n",
    "rows = []\n",
    "\n",
    "for k in [1, 2, 5, 10, 100, 1000]:\n",
    "    xk = np.array([1 - 1/k, 2 + 2/k**2, -3/k], dtype=float)\n",
    "    e = xk - x_limit\n",
    "    rows.append([\n",
    "        k,\n",
    "        *xk,\n",
    "        np.linalg.norm(e, 1),\n",
    "        np.linalg.norm(e, 2),\n",
    "        np.linalg.norm(e, np.inf)\n",
    "    ])\n",
    "\n",
    "pd.DataFrame(\n",
    "    rows,\n",
    "    columns=[\"k\", \"x1(k)\", \"x2(k)\", \"x3(k)\", \"||e_k||_1\", \"||e_k||_2\", \"||e_k||_inf\"]\n",
    ")\n"
   ]
