    "\n",
    "A = np.array([\n",
    "    [ 2, 0, -1],\n",
    "    [ 0, 5, -4],\n",
    "    [-3, 1,  3]\n",
    "], dtype=float)\n",
    "b = np.array([1, 1, 1], dtype=float)\n",
    "x_star = np.ones(3)\n",
    "\n",
    "print(\"A có đường chéo trội nghiêm ngặt theo dòng?\",\n",
    "      strictly_row_diagonally_dominant(A))\n",
    "\n",
    "D, L, U, BJ, gJ, BGS, gGS = iteration_matrices(A, b)\n",
    "\n",
    "rho_J, eig_J = spectral_radius(BJ)\n",
    "rho_GS, eig_GS = spectral_radius(BGS)\n",
    "\n",
    "print(\"\\nB_J =\")\n",
    "print(BJ)\n",
    "print(\"g_J =\", gJ)\n",
    "print(\"Trị riêng B_J =\", eig_J)\n",
    "print(\"rho(B_J) =\", rho_J)\n",
    "\n",
    "print(\"\\nB_GS =\")\n",
    "print(BGS)\n",
    "print(\"g_GS =\", gGS)\n",
    "print(\"Trị riêng B_GS =\", eig_GS)\n",
    "print(\"rho(B_GS) =\", rho_GS)\n",
    "\n",
    "rows_J = []\n",
    "x = np.zeros(3)\n",
    "for k in range(1, 11):\n",
    "    x = BJ @ x + gJ\n",
    "    err = np.linalg.norm(x_star - x, np.inf)\n",
    "    rows_J.append([k, *x, err])\n",
    "\n",
    "rows_GS = []\n",
    "x = np.zeros(3)\n",
    "for k in range(1, 11):\n",
    "    x = BGS @ x + gGS\n",
    "    err = np.linalg.norm(x_star - x, np.inf)\n",
    "    rows_GS.append([k, *x, err])\n",
    "\n",
    "tab_J = pd.DataFrame(rows_J, columns=[\"k\", \"x1\", \"x2\", \"x3\", \"true_error_inf\"])\n",
    "tab_GS = pd.DataFrame(rows_GS, columns=[\"k\", \"x1\", \"x2\", \"x3\", \"true_error_inf\"])\n",
    "\n",
    "print(\"\\nJacobi:\")\n",
    "display(tab_J)\n",
    "\n",
    "print(\"\\nGauss--Seidel:\")\n",
    "display(tab_GS)\n"
   ]
