   "source": [
    "\n",
    "K = np.array([\n",
    "    [12, -3, -2],\n",
    "    [-3, 10, -2],\n",
    "    [-2, -2,  9]\n",
    "], dtype=float)\n",
    "F = np.array([50, 40, 35], dtype=float)\n",
    "\n",
    "print(\"K đối xứng?\", np.allclose(K, K.T))\n",
    "print(\"Các trị riêng của K:\", np.linalg.eigvalsh(K))\n",
    "\n",
    "gd3 = gradient_descent_steps(K, F, x0=np.zeros(3), n_steps=3)\n",
    "print(\"Gradient Descent:\")\n",
    "display(gd3)\n",
    "\n",
    "jac3, _, _, _ = jacobi_steps(K, F, x0=np.zeros(3), n_steps=3)\n",
    "gs3, _, _, _, _ = gauss_seidel_steps(K, F, x0=np.zeros(3), n_steps=3)\n",
    "\n",
    "u_gd = gd3.iloc[-1][[\"x1\", \"x2\", \"x3\"]].to_numpy(dtype=float)\n",
    "u_jac = jac3.iloc[-1][[\"x1\", \"x2\", \"x3\"]].to_numpy(dtype=float)\n",
    "u_gs = gs3.iloc[-1][[\"x1\", \"x2\", \"x3\"]].to_numpy(dtype=float)\n",
    "\n",
    "comparison = pd.DataFrame({\n",
    "    \"Phương pháp\": [\"Gradient Descent\", \"Jacobi\", \"Gauss--Seidel\"],\n",
    "    \"u1\": [u_gd[0], u_jac[0], u_gs[0]],\n",
    "    \"u2\": [u_gd[1], u_jac[1], u_gs[1]],\n",
    "    \"u3\": [u_gd[2], u_jac[2], u_gs[2]],\n",
    "    \"||F-Ku||_2\": [\n",
    "        np.linalg.norm(F - K @ u_gd, 2),\n",
    "        np.linalg.norm(F - K @ u_jac, 2),\n",
    "        np.linalg.norm(F - K @ u_gs, 2)\n",
    "    ]\n",
    "})\n",
    "\n",
    "comparison\n"
   ]
  },
