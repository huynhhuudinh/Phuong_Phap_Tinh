    "\n",
    "## Ví dụ 7 — Phương pháp Gauss--Seidel\n",
    "\n",
    "Giải gần đúng hệ\n",
    "\n",
    "\$$\n",
    "\\begin{aligned}\n",
    "10x_1+x_2+x_3=12,\\\\\n",
    "x_1+10x_2+x_3=12,\\\\\n",
    "x_1+x_2+10x_3=12,\n",
    "\\end{aligned}\n",
    "\$$\n",
    "\n",
    "qua bốn bước lặp.\n",
    "\n",
    "Chọn\n",
    "\n",
    "\$$\n",
    "\\mathbf x_0=(0;0;0).\n",
    "\$$\n",
    "\n",
    "Theo chương,\n",
    "\n",
    "\$$\n",
    "\\|\\mathbf H\\|_\\infty=0.2\n",
    "\$$\n",
    "\n",
    "và hệ số dùng để đánh giá sai số là\n",
    "\n",
    "\$$\n",
    "\\gamma=0.2.\n",
    "\$$\n"
   ]
