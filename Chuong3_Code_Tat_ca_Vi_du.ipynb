    "\n",
    "A = np.array([\n",
    "    [12, 1, 2],\n",
    "    [ 1,12, 1],\n",
    "    [ 2, 1,12]\n",
    "], dtype=float)\n",
    "b = np.array([15, 14, 15], dtype=float)\n",
