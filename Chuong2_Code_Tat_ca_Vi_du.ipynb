   "source": [
    "\n",
    "import math\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "pd.set_option(\"display.precision\", 12)\n",
    "\n",
    "def bisection_steps(f, a, b, n_max):\n",
    "    if f(a) * f(b) >= 0:\n",
    "        raise ValueError(\"Cần f(a)f(b) < 0.\")\n",
    "    rows = []\n",
    "    a0, b0 = a, b\n",
    "    for n in range(n_max + 1):\n",
    "        x = (a + b) / 2\n",
    "        prod = f(a) * f(x)\n",
    "        err = (b0 - a0) / (2 ** (n + 1))\n",
    "        rows.append([n, a, b, x, prod, err])\n",
    "        if n == n_max or f(x) == 0:\n",
    "            break\n",
    "        if prod < 0:\n",
    "            b = x\n",
    "        else:\n",
    "            a = x\n",
    "    return pd.DataFrame(rows, columns=[\"n\", \"a_n\", \"b_n\", \"x_n\", \"f(a_n)f(x_n)\", \"error_bound\"])\n",
    "\n",
    "def fixed_point_steps(phi, x0, L, n_max):\n",
    "    rows = []\n",
    "    x_old = x0\n",
    "    for n in range(1, n_max + 1):\n",
    "        x_new = phi(x_old)\n",
    "        err = (L / (1 - L)) * abs(x_new - x_old)\n",
    "        rows.append([n, x_new, err])\n",
    "        x_old = x_new\n",
    "    return pd.DataFrame(rows, columns=[\"n\", \"x_n\", \"error_bound\"])\n",
    "\n",
    "def fixed_point_until_tol(phi, x0, L, tol, max_iter=1000):\n",
    "    rows = []\n",
    "    x_old = x0\n",
    "    for n in range(1, max_iter + 1):\n",
    "        x_new = phi(x_old)\n",
    "        err = (L / (1 - L)) * abs(x_new - x_old)\n",
    "        rows.append([n, x_new, err])\n",
    "        if err < tol:\n",
    "            break\n",
    "        x_old = x_new\n",
    "    return pd.DataFrame(rows, columns=[\"n\", \"x_n\", \"error_bound\"])\n",
    "\n",
    "def apriori_iterations(phi, x0, L, tol):\n",
    "    x1 = phi(x0)\n",
    "    q = ((1 - L) * tol) / abs(x1 - x0)\n",
    "    return math.ceil(math.log(q) / math.log(L))\n",
    "\n",
    "def newton_steps(f, fp, x0, m, M, n_max):\n",
    "    rows = []\n",
    "    x_old = x0\n",
    "    for n in range(1, n_max + 1):\n",
    "        x_new = x_old - f(x_old) / fp(x_old)\n",
    "        err = (M / (2 * m)) * (x_new - x_old) ** 2\n",
    "        rows.append([n, x_new, err])\n",
    "        x_old = x_new\n",
    "    return pd.DataFrame(rows, columns=[\"n\", \"x_n\", \"error_bound\"])\n",
    "\n",
    "def newton_until_tol(f, fp, x0, m, M, tol, max_iter=100):\n",
    "    rows = []\n",
    "    x_old = x0\n",
    "    for n in range(1, max_iter + 1):\n",
    "        x_new = x_old - f(x_old) / fp(x_old)\n",
    "        err = (M / (2 * m)) * (x_new - x_old) ** 2\n",
    "        rows.append([n, x_new, err])\n",
    "        if err < tol:\n",
    "            break\n",
    "        x_old = x_new\n",
    "    return pd.DataFrame(rows, columns=[\"n\", \"x_n\", \"error_bound\"])\n"
   ]
