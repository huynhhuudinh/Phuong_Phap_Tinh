    "\n",
    "tests = [\n",
    "    (\"x^3 + x - 3\", lambda x: x**3 + x - 3, lambda x: 3*x**2 + 1, 1, 2),\n",
    "    (\"exp(x) - 3x\", lambda x: math.exp(x) - 3*x, lambda x: math.exp(x) - 3, 0, 1),\n",
    "    (\"x + ln(x) - 2\", lambda x: x + math.log(x) - 2, lambda x: 1 + 1/x, 1, 2),\n",
    "]\n",
    "\n",
    "rows = []\n",
    "for name, f, fp, a, b in tests:\n",
    "    grid = np.linspace(a, b, 1001)\n",
    "    deriv = np.array([fp(x) for x in grid])\n",
    "    sign_constant = np.all(deriv > 0) or np.all(deriv < 0)\n",
    "    rows.append([name, f(a), f(b), f(a)*f(b), deriv.min(), deriv.max(), sign_constant])\n",
    "\n",
    "pd.DataFrame(rows, columns=[\n",
    "    \"Phương trình\", \"f(a)\", \"f(b)\", \"f(a)f(b)\", \"min f'(x)\", \"max f'(x)\", \"f' không đổi dấu\"\n",
    "])\n"
   ]
