    "\n",
    "f = lambda x: x**3 - 3*x**2 + 1\n",
    "fp = lambda x: 3*x**2 - 6*x\n",
    "\n",
    "# Trên [0.6,0.7]:\n",
    "# |f'| nhỏ nhất tại x=0.6 và |f''| lớn nhất tại x=0.6.\n",
    "m = abs(fp(0.6))\n",
    "M = abs(6*0.6 - 6)\n",
    "\n",
    "tab = newton_until_tol(f, fp, x0=0.7, m=m, M=M, tol=1e-7)\n",
    "tab\n"
   ]
