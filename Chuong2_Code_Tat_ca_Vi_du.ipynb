    "\n",
    "phi = lambda x: x/2 + x**2\n",
    "\n",
    "def raw_fixed_point(phi, x0, n_max):\n",
    "    xs = [x0]\n",
    "    x = x0\n",
    "    for _ in range(n_max):\n",
    "        x = phi(x)\n",
    "        xs.append(x)\n",
    "    return xs\n",
    "\n",
    "x_pos = raw_fixed_point(phi, 0.2, 8)\n",
    "x_neg = raw_fixed_point(phi, -1.5, 8)\n",
    "\n",
    "pd.DataFrame({\n",
    "    \"n\": range(9),\n",
    "    \"x_n (x0=0.2)\": x_pos,\n",
    "    \"x_n (x0=-1.5)\": x_neg\n",
    "})\n"
   ]
  },
